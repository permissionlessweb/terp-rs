# Spectrum pure-seam / harness recipes (no Docker, no H1 prove).
# Prefer `just demo-e2e-l0` from `crates/headstash` for suite re-exports too.

fixtures := justfile_directory() / "fixtures"

# Run four L0 pure crates only (fast PR CI seed).
e2e-l0-pure:
        #!/usr/bin/env bash
        set -euo pipefail
        for c in bridge_auth_seams private_dex_seams seam_note_out compose_seams; do
          echo "== $c =="
          (cd "{{fixtures}}/$c" && cargo test)
        done

# Product pure e2e (V0c): register → bridge mint note → SwapAction apply → reserves+ν
product-pure-e2e:
        #!/usr/bin/env bash
        set -euo pipefail
        (cd "{{fixtures}}/compose_seams" && cargo test product_path_burn_to_swap_sketch -- --nocapture)

# -----------------------------------------------------------------------------
# spine-t1 — Card C / Spine T1 named corridor (pure L0 only; no Docker, no Halo2)
#
# Single compose of existing green crates. Not a new framework: shell orchestration
# of cargo test targets already used by product-pure-e2e + e2e-l0-pure.
#
# FLOW matrix C0/C1 → L0 coverage (honest partial):
#   C0.1  burn→bridge_mint note accept
#         → bridge_auth_seams: t1_happy_path_mint, hinge_t1_authorize_bridge_mint_happy
#         → compose_seams: c1_happy_bridge_mint_to_seam_note_out + product_path_burn_to_swap_sketch
#   C0.2  unshield exit                    → not pure-L0 green (needs SEAM-SPEND exit fixture / L1)
#   C0.3  bridge_burn → SEAM-CROSS-OUT     → not pure-L0 green (C8 suite; design)
#   C0.4  conservation burn-in = out       → product_path reserves+ν + bridge value/conservation rejects
#   C1.1  claim → private note             → not cashapp corridor (distro claim = Domain A / L1 headstash);
#         cashapp covers deposit-intent corridor analog, not eligibility root claim
#   C1.2  note → swap, public reserves Δ   → product_path_burn_to_swap_sketch + private_dex_seams::swap_happy
#         (+ swap_action structural / seam→swap compose tests)
#   C1.3  oracle-bound swap (fresh mid)    → private_dex oracle_* + cashapp i5 happy / i2 slip / i6 stale
#   C1.4  post-swap exit                   → not pure-L0 green (exit path deferred)
#   C1.5  anonymity-set property           → not automated here (doc/property only)
#
# Why one recipe (not split): all targets are pure cargo tests under fixtures/, no
# Docker/feature gates, same host toolchain — sequential bash is enough.
# cashapp_zec_corridor is intentionally outside e2e-l0-pure (BTC/ZEC corridor demo);
# spine-t1 pulls it in as the E-BTC L0 product spine companion.
# private_dex_seams included: already green, cheap, underpins C1.2–C1.3.
# -----------------------------------------------------------------------------
spine-t1:
        #!/usr/bin/env bash
        set -euo pipefail
        echo "=== spine-t1: compose_seams product_path_burn_to_swap_sketch ==="
        (cd "{{fixtures}}/compose_seams" && cargo test product_path_burn_to_swap_sketch -- --nocapture)
        echo "=== spine-t1: cashapp_zec_corridor (full) ==="
        (cd "{{fixtures}}/cashapp_zec_corridor" && cargo test)
        echo "=== spine-t1: bridge_auth_seams (full) ==="
        (cd "{{fixtures}}/bridge_auth_seams" && cargo test)
        echo "=== spine-t1: private_dex_seams (full; C1.2–C1.3 cheap) ==="
        (cd "{{fixtures}}/private_dex_seams" && cargo test)
        echo "=== spine-t1: ALL STEPS GREEN ==="

# L1 Mock bridge mint — delegate to crates/headstash (cw-orch + cw-headstash).
e2e-l1:
        just --justfile {{justfile_directory()}}/../../../crates/headstash/justfile e2e-l1

