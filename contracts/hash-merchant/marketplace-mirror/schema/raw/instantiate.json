{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InstantiateMsg",
  "type": "object",
  "required": [
    "accepted_denom",
    "admin"
  ],
  "properties": {
    "accepted_denom": {
      "description": "Bank denom accepted for purchases (e.g. `uterp`).",
      "type": "string"
    },
    "admin": {
      "description": "Contract admin (also protocol-fee recipient when fee is set).",
      "type": "string"
    },
    "min_buffer_blocks": {
      "description": "Settlement buffer in blocks. Default **7**. Allowed range **5–10**.",
      "default": 7,
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "protocol_fee_bps": {
      "description": "Optional protocol fee in basis points (100 = 1%). Taken on settle.",
      "default": null,
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false
}
